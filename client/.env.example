[TEMPLATE]
# Used for Google sign-in (optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
# Deployed backend URL — e.g. https://your-backend.onrender.com/api
# Leave unset for local development (falls back to http://localhost:5001/api)
VITE_API_URL=

# Demo account emails pre-filled on the login form (emails only — no passwords
# are ever shipped in frontend code). Fall back to the seeded demo accounts
# from server/src/scripts/seed.js when unset.
VITE_DEMO_STUDENT_EMAIL=
VITE_DEMO_CONSULTANT_EMAIL=
VITE_DEMO_ADMIN_EMAIL=
